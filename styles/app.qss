* {
    font-family: "Segoe UI", "Ubuntu", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #1a1a1a;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #ffffff;
}

QWidget {
    background-color: transparent;
}

#mainContainer {
    background-color: #f9fafb;
}

#leftPanel {
    background-color: #ffffff;
}

#banner {
    background-color: #ffffff;
    border-bottom: 2px solid #e5e7eb;
    min-height: 52px;
}

#bannerApp {
    font-size: 19px;
    font-weight: 700;
    color: #1a1a1a;
    letter-spacing: 0.3px;
}

#bannerApi {
    font-size: 11px;
    color: #9ca3af;
    font-style: italic;
}

#loadingBar {
    background-color: #dbeafe;
    border: none;
}

#loadingBar::chunk {
    background-color: #3b82f6;
}

QMenuBar {
    background-color: #ffffff;
    color: #1a1a1a;
    border-bottom: 1px solid #e5e7eb;
    padding: 2px 8px;
}

QMenuBar::item {
    padding: 6px 14px;
    border-radius: 5px;
    color: #1a1a1a;
}

QMenuBar::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}

QMenu {
    background-color: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 14px;
    border-radius: 5px;
    color: #1a1a1a;
}

QMenu::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}

QMenu::separator {
    height: 1px;
    background-color: #e5e7eb;
    margin: 4px 8px;
}

#mainSplitter {
    background-color: #f9fafb;
}

QSplitter::handle {
    background-color: #e5e7eb;
    width: 1px;
}

#tabSectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a1a;
}

#btnRefresh {
    background-color: #ffffff;
    color: #6b7280;
    border: 1.5px solid #e5e7eb;
    border-radius: 7px;
    font-size: 14px;
}

#btnRefresh:hover {
    background-color: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
}

#btnPrimary {
    background-color: #ffffff;
    color: #1d4ed8;
    font-weight: 700;
    padding: 0px 14px;
    border: 2px solid #3b82f6;
    border-radius: 7px;
}

#btnPrimary:hover {
    background-color: #eff6ff;
    border-color: #1d4ed8;
    color: #1e40af;
}

#btnPrimary:pressed {
    background-color: #bfdbfe;
    border-color: #1e40af;
}

#btnPrimary:disabled {
    border-color: #e5e7eb;
    color: #9ca3af;
}

#btnSecondary {
    background-color: #ffffff;
    color: #374151;
    font-weight: 700;
    padding: 0px 14px;
    border: 1.5px solid #d1d5db;
    border-radius: 7px;
    letter-spacing: 0.5px;
}

#btnSecondary:hover:enabled {
    background-color: #f9fafb;
    border-color: #6b7280;
    color: #111827;
}

#btnSecondary:pressed {
    background-color: #f3f4f6;
}

#btnSecondary:disabled {
    border-color: #e5e7eb;
    color: #d1d5db;
    background-color: #fafafa;
}

#btnDanger {
    background-color: #ffffff;
    color: #dc2626;
    font-weight: 700;
    padding: 0px 14px;
    border: 2px solid #fca5a5;
    border-radius: 7px;
    letter-spacing: 0.5px;
}

#btnDanger:hover:enabled {
    background-color: #fff1f2;
    border-color: #ef4444;
    color: #b91c1c;
}

#btnDanger:pressed {
    background-color: #fee2e2;
    border-color: #dc2626;
}

#btnDanger:disabled {
    border-color: #e5e7eb;
    color: #d1d5db;
    background-color: #fafafa;
}

#dataTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    gridline-color: #f3f4f6;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
}

#dataTable QHeaderView::section {
    background-color: #f9fafb;
    color: #374151;
    font-weight: 700;
    font-size: 12px;
    padding: 10px 10px;
    border: none;
    border-bottom: 2px solid #bfdbfe;
    letter-spacing: 0.3px;
}

#dataTable QTableWidget::item {
    padding: 10px 10px;
    border-bottom: 1px solid #f3f4f6;
    color: #1a1a1a;
}

#dataTable QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
    font-weight: 600;
}

#errorLabel {
    background-color: #fff1f2;
    color: #b91c1c;
    border: 1.5px solid #fca5a5;
    border-radius: 7px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
}

#panelDetail {
    background-color: #ffffff;
    border-left: 1.5px solid #e5e7eb;
}

#panelHeader {
    background-color: #f9fafb;
    border-bottom: 1.5px solid #e5e7eb;
}

#panelTitle {
    font-size: 13px;
    font-weight: 700;
    color: #1a1a1a;
}

#panelSubinfo {
    font-size: 11px;
    color: #6b7280;
    margin-top: 2px;
}

#scrollDetail {
    background-color: transparent;
}

#detailContent {
    background-color: #ffffff;
}

#detailPlaceholder {
    color: #9ca3af;
    font-size: 13px;
    line-height: 1.6;
    padding: 24px;
}

#detailError {
    color: #b91c1c;
    font-size: 13px;
    padding: 16px;
}

#detailID {
    font-size: 12px;
    font-weight: 700;
    color: #9ca3af;
    letter-spacing: 0.5px;
}

#detailTitle {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    line-height: 1.4;
}

#detailMeta {
    background-color: #f9fafb;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
}

#metaLabel {
    font-size: 11px;
    font-weight: 700;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

#metaValue {
    font-size: 12px;
    color: #374151;
}

#detailSectionHdr {
    font-size: 11px;
    font-weight: 700;
    color: #9ca3af;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    border-bottom: 1px solid #f3f4f6;
    padding-bottom: 4px;
}

#detailBody {
    font-size: 13px;
    color: #374151;
    line-height: 1.6;
}

#commentCard {
    background-color: #f9fafb;
    border: 1.5px solid #e5e7eb;
    border-left: 3px solid #bfdbfe;
    border-radius: 8px;
}

#commentName {
    font-size: 12px;
    font-weight: 700;
    color: #1d4ed8;
}

#commentEmail {
    font-size: 11px;
    color: #9ca3af;
    font-style: italic;
}

#commentBody {
    font-size: 12px;
    color: #374151;
    line-height: 1.5;
}

#inputField {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1.5px solid #d1d5db;
    border-radius: 7px;
    padding: 8px 12px;
    min-height: 32px;
    selection-background-color: #bfdbfe;
    selection-color: #1a1a1a;
}

#inputField:focus {
    border-color: #3b82f6;
    background-color: #f0f9ff;
}

#inputField:hover {
    border-color: #9ca3af;
}

#inputTextEdit {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1.5px solid #d1d5db;
    border-radius: 7px;
    padding: 8px 12px;
    selection-background-color: #bfdbfe;
    selection-color: #1a1a1a;
}

#inputTextEdit:focus {
    border-color: #3b82f6;
    background-color: #f0f9ff;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1.5px solid #bfdbfe;
    border-radius: 7px;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
    padding: 4px;
    color: #1a1a1a;
}

#slugHint {
    font-size: 11px;
    color: #9ca3af;
    margin-left: 4px;
}

#dialogPost {
    background-color: #ffffff;
}

#dialogHeader {
    background-color: #f0f9ff;
    border-bottom: 2px solid #bfdbfe;
}

#dialogTitle {
    font-size: 16px;
    font-weight: 700;
    color: #1d4ed8;
}

#dialogSubtitle {
    font-size: 12px;
    color: #6b7280;
    margin-top: 2px;
}

#dialogBody {
    background-color: #ffffff;
}

#dialogBody QLabel {
    color: #374151;
    font-size: 12px;
    font-weight: 600;
}

#dialogFooter {
    background-color: #f9fafb;
    border-top: 1px solid #e5e7eb;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #1a1a1a;
    font-size: 13px;
}

QMessageBox QPushButton {
    background-color: #ffffff;
    color: #1d4ed8;
    font-weight: 700;
    padding: 8px 24px;
    border: 2px solid #3b82f6;
    border-radius: 6px;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #eff6ff;
    border-color: #1d4ed8;
}

QStatusBar {
    background-color: #f9fafb;
    color: #6b7280;
    border-top: 1px solid #e5e7eb;
    font-size: 12px;
    padding: 4px 12px;
}

QScrollBar:vertical {
    background-color: #f3f4f6;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #d1d5db;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9ca3af;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    height: 8px;
    background-color: #f3f4f6;
}

QScrollBar::handle:horizontal {
    background-color: #d1d5db;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QToolTip {
    background-color: #1e3a8a;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 6px 10px;
    font-weight: 600;
}
